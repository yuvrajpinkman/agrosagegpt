# AgroSageGPT Configuration
# LLM API key (e.g. OpenAI, Google Gemini, Groq, or Hugging Face)
LLM_API_KEY=your_llm_api_key_here

# OpenWeatherMap API key (Free tier from https://openweathermap.org/api)
OPENWEATHER_API_KEY=your_openweather_api_key_here

# Default Location for Weather
DEFAULT_LOCATION=Bengaluru
